# ApolloMedia — variáveis do stack. O arquivo real vive em
# /root/plan-secrets/apollo-media.env (chmod 600) e é apontado por symlink:
#   ln -s /root/plan-secrets/apollo-media.env /root/apollo-media/deploy/.env
# NUNCA commitar o .env preenchido.

# --- Segredos (gerar com: openssl rand -hex 32) ---
POSTGRES_USER=postiz
POSTGRES_PASSWORD=
TEMPORAL_POSTGRES_PASSWORD=
JWT_SECRET=

# --- URLs. As três precisam bater com o host servido pelo Caddy; se
# NEXT_PUBLIC_BACKEND_URL apontar para outro lugar, o app carrega e toda
# chamada de API falha no navegador (tela em branco, sem erro no log).
MAIN_URL=https://app.apollomedia.com.br
FRONTEND_URL=https://app.apollomedia.com.br
NEXT_PUBLIC_BACKEND_URL=https://app.apollomedia.com.br/api

# --- SSO com o ApolloAuth (E5) — LIGADO em 26/out/2026 ---
#
# ⚠️ CORREÇÃO de um aviso que estava aqui e era FALSO: dizia que ligar o OIDC
# desabilita o login local. NÃO desabilita. Conferido no fonte desta versão
# (login.tsx): o formulário de e-mail e senha é renderizado FORA do ternário
# de provedores — o OIDC só troca QUAIS BOTÕES de provedor aparecem (com ele
# ligado, o botão do Google some e entra o do ApolloAuth). Não há risco de
# ficar trancado para fora.
#
# ⚠️ O QUE É RISCO DE VERDADE: com SSO ligado, o DISABLE_REGISTRATION DEIXA DE
# PROTEGER. O auth.service.ts tem a exceção explícita
#     canRegister() => DISABLE_REGISTRATION !== 'true' || provider === GENERIC
# ou seja, QUALQUER pessoa que autentique no ApolloAuth ganha conta aqui
# automaticamente, numa organização nova dela. O portão passa a ser o POLICY
# BINDING do Authentik — app sem binding é porta ABERTA, não fechada.
#
# ⚠️ O redirect_uri é CRAVADO no código como `${FRONTEND_URL}/settings` (sim,
# /settings, não um /callback). É esse valor que tem de estar registrado no
# provider do Authentik. O escopo também é fixo: openid profile email.
# POSTIZ_OAUTH_URL e POSTIZ_OAUTH_SCOPE abaixo NÃO são lidos pelo código.
# POSTIZ_GENERIC_OAUTH=true
# POSTIZ_OAUTH_URL=
# POSTIZ_OAUTH_AUTH_URL=
# POSTIZ_OAUTH_TOKEN_URL=
# POSTIZ_OAUTH_USERINFO_URL=
# POSTIZ_OAUTH_CLIENT_ID=
# POSTIZ_OAUTH_CLIENT_SECRET=
# POSTIZ_OAUTH_SCOPE=openid profile email
# NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=ApolloAuth

# --- Apps de API das redes (E2). Cada par vem de um app de desenvolvedor
# NOSSO, com app review próprio. Vazio = a rede não aparece para conectar.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=

# --- Opcionais
OPENAI_API_KEY=
NEXT_PUBLIC_DISCORD_SUPPORT=
