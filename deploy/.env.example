# ApolloMedia — variáveis do stack. O arquivo real vive em
# /root/plan-secrets/apollo-media.env (chmod 600) e é apontado por symlink:
#   ln -s /root/plan-secrets/apollo-media.env /root/apollo-media/deploy/.env
# NUNCA commitar o .env preenchido.

# --- Segredos (gerar com: openssl rand -hex 32) ---
POSTGRES_USER=postiz
POSTGRES_PASSWORD=
TEMPORAL_POSTGRES_PASSWORD=
JWT_SECRET=

# --- URLs. As três precisam bater com o host servido pelo Caddy; se
# NEXT_PUBLIC_BACKEND_URL apontar para outro lugar, o app carrega e toda
# chamada de API falha no navegador (tela em branco, sem erro no log).
MAIN_URL=https://app.apollomedia.com.br
FRONTEND_URL=https://app.apollomedia.com.br
NEXT_PUBLIC_BACKEND_URL=https://app.apollomedia.com.br/api

# --- SSO (E5). Deixar comentado até a E5: ligar o OIDC DESABILITA o login
# local, e sem app registrado no ApolloAuth ninguém entra.
# POSTIZ_GENERIC_OAUTH=true
# POSTIZ_OAUTH_URL=
# POSTIZ_OAUTH_AUTH_URL=
# POSTIZ_OAUTH_TOKEN_URL=
# POSTIZ_OAUTH_USERINFO_URL=
# POSTIZ_OAUTH_CLIENT_ID=
# POSTIZ_OAUTH_CLIENT_SECRET=
# POSTIZ_OAUTH_SCOPE=openid profile email
# NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=ApolloAuth

# --- Apps de API das redes (E2). Cada par vem de um app de desenvolvedor
# NOSSO, com app review próprio. Vazio = a rede não aparece para conectar.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=

# --- Opcionais
OPENAI_API_KEY=
NEXT_PUBLIC_DISCORD_SUPPORT=
